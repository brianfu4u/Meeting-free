    "sku": {
      "type": "string",
      "description": "\u8bbe\u5907\u5e8f\u5217\u53f7/SKU\u3002equipment \u7c7b\u522b\u4e0b\u4e0e EvidenceFactCard.device_serial \u5bf9\u5e94\uff0c\u7528\u4e8e\u5339\u914d\u5f53\u65e5\u7279\u68c0\u62a5\u544a\u5355\u636e\u5e76\u8ba1\u8bbe\u5907\u4f7f\u7528\u6b21\u6570\u3002"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "\u5f53\u524d\u5e93\u5b58\u6570\u91cf"
    },
    "threshold": {
      "type": "number",
      "default": 0,
      "description": "\u5b89\u5168\u5e93\u5b58\u9608\u503c\uff0c\u4f4e\u4e8e\u89e6\u53d1INVENTORY_BELOW_THRESHOLD"
    },
    "unit": {
      "type": "string",
      "description": "\u5355\u4f4d"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "\u8d2d\u7f6e\u65e5\u671f\uff08\u4ec5 equipment \u7c7b\u522b\u4f7f\u7528\uff09\u3002\u7528\u4e8e\u8ba1\u7b97\u56fa\u5b9a\u8d44\u4ea7\u4f7f\u7528\u5e74\u9650\uff1a\u8ddd\u4eca\u5e74\u6570\u3002"
