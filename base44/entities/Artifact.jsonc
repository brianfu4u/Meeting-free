{"name":"Artifact","type":"object","properties":{"clinic_id":{"type":"string","description":"门店唯一标识，严格 Tenant 逻辑隔离字段，来自服务端认证上下文"},"artifact_type":{"type":"string","enum":["image","file","voice","screenshot","text"],"description":"原始证据载体类型：照片/文件/语音/截图/文本。Phase 5 新增 text。"},"fragment_type":{"type":"string","enum":["image","document","audio","text"],"description":"Phase 5：多模态碎片类型。与 artifact_type 并存，Phase 1–4 编组器不读取本字段。"},"file_url":{"type":"string","description":"证据文件 URL（UploadFile 产出），存储 Key 须经 Tenant Scope 命名。创建后不可覆盖。"},"source_staff_id":{"type":"string","description":"上传员工 Staff ID（服务端从 Staff 绑定解析，禁止信任客户端 staff_id）"},"source_session_id":{"type":"string","description":"关联 PatientSession ID（患者相关时必填，非患者可空）"},"source_event_id":{"type":"string","description":"产出本碎片的 AuditLog event_id（溯源链入口）"},"origin_evidence_item_id":{"type":"string","description":"方向A实时桥接幂等键：来源 EvidenceItem ID；同 clinic_id 下只允许一条有效桥接链"},"source_region":{"type":"string","description":"来源区域/部门职能编码（如 reception/optometry/medical）"},"source_role":{"type":"string","description":"Server-validated uploader role used as source-context evidence; never trust an unverified client role"},"category_id":{"type":"string","description":"Stable upload micro-explanation category key; strong prior, never ground truth"},"is_proxy":{"type":"boolean","default":false,"description":"Whether the authenticated uploader explicitly declared an on-behalf-of upload"},"proxy_for_role":{"type":"string","description":"Server-validated declared business role represented by a proxy upload"},"exception_class":{"type":"string","enum":["manager_approved_exception"],"description":"Explicit exceptional context isolated from normal assembly and rule learning"},"normal_rule_learning_eligible":{"type":"boolean","default":true,"description":"False permanently excludes this Artifact from normal policy/rule learning"},"source_workflow_id":{"type":"string","description":"Phase 3：显式绑定 Workflow ID（CandidateFinder explicit_id 自动挂接依据）"},"linked_undo_artifact_id":{"type":"string","description":"次日回流 self_supplement 绑定：本车厢是对 linked_undo_artifact_id 所指旧车厢的人工补充说明。编组时强制将两者分入同一 cluster，无需 LLM 推断同源性。"},"business_date":{"type":"string","format":"date","description":"业务日期（本地时区），用于跨日归档与今日过滤"},"captured_at":{"type":"string","format":"date-time","description":"采集/上传时间戳。客户端可提交，服务端兜底为 received_at。创建后不可覆盖。"},"ingestion_seq":{"type":"number","description":"入站事件序号，对应当时水位 cutoff_event_seq"},"interpreted":{"type":"boolean","default":false,"description":"是否已被 Evidence Interpreter 生成 EvidenceFactCard"},"evidence_fact_card_id":{"type":"string","description":"主 FactCard ID（1:1 缓存）"},"client_request_id":{"type":"string","description":"Phase 5：客户端幂等键。与 clinic_id 组成 ingestion_key。"},"ingestion_key":{"type":"string","description":"Phase 5：clinic_id::client_request_id，入站唯一性索引。"},"mime_type":{"type":"string","description":"Phase 5：服务端嗅探后的 MIME 类型。"},"original_filename":{"type":"string","description":"Phase 5：原始文件名（脱敏后保存，不含路径）。"},"file_size":{"type":"number","description":"Phase 5：文件字节数（服务端校验）。"},"checksum":{"type":"string","description":"Phase 5：客户端提交的校验和（可选，不作为信任依据）。"},"received_at":{"type":"string","format":"date-time","description":"Phase 5：服务端接收时间戳。"},"source_channel":{"type":"string","description":"Phase 5：入站渠道（如 staff_pad/web/dashboard）。"},"original_metadata":{"type":"object","description":"Phase 5：不可变原始 metadata（设备/位置提示等客户端上下文，不作为已验证事实）。","additionalProperties":true},"adapter_name":{"type":"string","description":"Phase 5：处理本碎片的 Adapter 名（image/document/audio/text）。"},"adapter_version":{"type":"string","description":"Phase 5：Adapter 版本。"}},"required":["clinic_id","artifact_type","file_url","source_staff_id","business_date","captured_at"]}
