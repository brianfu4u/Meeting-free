{
  "name": "PatientSession",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5\uff0c\u514b\u9686\u65f6\u6ce8\u5165\u4e0d\u53ef\u4fee\u6539"
    },
    "qr_code": {
      "type": "string",
      "description": "\u7269\u7406\u75c5\u5386\u7801\uff0c\u60a3\u8005\u5168\u6d41\u7a0b\u6d41\u8f6c\u552f\u4e00\u951a\u70b9"
    },
    "patient_name": {
      "type": "string",
      "description": "\u60a3\u8005\u59d3\u540d"
    },
    "patient_phone": {
      "type": "string",
      "description": "\u60a3\u8005\u8054\u7cfb\u7535\u8bdd"
    },
    "business_line": {
      "type": "string",
      "enum": [
        "optometry",
        "medical",
        "vision_training"
      ],
      "description": "\u4e1a\u52a1\u7ebf\uff1a\u9a8c\u5149\u914d\u955c/\u773c\u79d1\u533b\u7597/\u89c6\u89c9\u8bad\u7ec3"
    },
    "current_node": {
      "type": "string",
      "description": "\u5f53\u524d\u6240\u5904\u6d41\u7a0b\u8282\u70b9"
    },
    "arrival_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u5230\u5e97\u65f6\u95f4\uff0c\u8ba1\u65f6\u672a\u542f\u52a8"
    },
    "seated_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u5c31\u5ea7\u65f6\u95f4\uff0c\u5019\u8bca\u8ba1\u65f6\u4ece\u6b64\u523b\u542f\u52a8"
    },
    "node_scan_timestamps": {
      "type": "object",
      "description": "\u5404\u8282\u70b9\u626b\u7801\u65f6\u95f4\u6233\u6620\u5c04 {\u8282\u70b9\u540d: \u65f6\u95f4\u6233}"
    },
    "status": {
      "type": "string",
      "enum": [
        "arrived",
        "seated",
        "in_progress",
        "completed",
        "stalled"
      ],
      "default": "arrived",
      "description": "\u5c31\u8bca\u4f1a\u8bdd\u72b6\u6001\u673a"
    },
    "assignee_staff_id": {
      "type": "string",
      "description": "\u5f53\u524d\u8d1f\u8d23\u5458\u5de5ID"
    }
  },
  "required": [
    "clinic_id",
    "qr_code",
    "business_line",
    "status"
  ]
}