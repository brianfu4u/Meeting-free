{
  "name": "RevenueTarget",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "\u76ee\u6807\u65e5\u671f"
    },
    "business_line": {
      "type": "string",
      "enum": [
        "optometry",
        "medical",
        "vision_training"
      ],
      "description": "\u4e1a\u52a1\u7ebf"
    },
    "target_amount": {
      "type": "number",
      "description": "\u76ee\u6807\u8425\u6536\u91d1\u989d"
    },
    "actual_amount": {
      "type": "number",
      "default": 0,
      "description": "\u5b9e\u9645\u8425\u6536\u91d1\u989d"
    },
    "achievement_rate": {
      "type": "number",
      "default": 0,
      "description": "\u8fbe\u6210\u7387\u767e\u5206\u6bd4"
    }
  },
  "required": [
    "clinic_id",
    "target_date",
    "business_line",
    "target_amount"
  ]
}