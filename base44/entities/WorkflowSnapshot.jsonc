{
  "name": "WorkflowSnapshot",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u4e25\u683c Tenant \u903b\u8f91\u9694\u79bb\u5b57\u6bb5"
    },
    "workflow_id": {
      "type": "string",
      "description": "Phase 3\uff1a\u5f52\u5c5e Workflow ID\uff08\u7248\u672c\u5316\u6295\u5f71\u5fc5\u987b\u5173\u8054 workflow_id\uff0c\u4e0d\u5f97\u627f\u62c5\u957f\u671f\u4e1a\u52a1\u6839\u804c\u8d23\uff09\u3002Phase 3 \u7f16\u6392\u5668\u5f3a\u5236\u5199\u5165\uff1blegacy pipelineEngine \u4f1a\u8bdd\u538b\u7f29\u6a21\u5f0f\u53ef\u7a7a\uff08\u4fdd\u7559\u517c\u5bb9\uff0c\u4e0d\u7834\u574f\u65e2\u6709\u8bed\u4e49\uff09\u3002"
    },
    "session_id": {
      "type": "string",
      "description": "\u5173\u8054 PatientSession ID\uff08\u4e1a\u52a1\u951a\u70b9\uff09"
    },
    "patient_name": {
      "type": "string",
      "description": "\u60a3\u8005\u59d3\u540d\uff08\u7f13\u5b58\uff0c\u4f9b Dashboard \u5feb\u901f\u5c55\u793a\uff09"
    },
    "business_line": {
      "type": "string",
      "enum": [
        "optometry",
        "medical",
        "vision_training"
      ],
      "description": "\u4e1a\u52a1\u7ebf"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u5de5\u4f5c\u6d41\u542f\u52a8\u65f6\u95f4\uff08\u5230\u8fbe\u65f6\u95f4\uff09"
    },
    "current_node": {
      "type": "string",
      "description": "\u5f53\u524d\u6240\u5904\u6d41\u7a0b\u8282\u70b9"
    },
    "nodes_completed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u5df2\u5b8c\u6210\u8282\u70b9\u5e8f\u5217\uff08\u6309\u5e8f\u6392\u5217\uff09"
    },
    "stage_durations": {
      "type": "object",
      "description": "\u5404\u8282\u70b9\u8017\u65f6\uff08\u5206\u949f\uff09\uff1a{ \u8282\u70b9\u540d: \u5206\u949f\u6570 }"
    },
    "bottleneck_node": {
      "type": "string",
      "description": "LLM \u8bc6\u522b\u7684\u5f53\u524d\u6700\u957f\u8017\u65f6\u8282\u70b9\uff08\u963b\u585e\u70b9\uff09"
    },
    "llm_summary": {
      "type": "string",
      "description": "LLM \u8bed\u4e49\u538b\u7f29\u6458\u8981"
    },
    "llm_recommendation": {
      "type": "string",
      "description": "LLM \u51b3\u7b56\u5efa\u8bae\uff08\u226450\u5b57\uff09"
    },
    "estimated_completion_minutes": {
      "type": "number",
      "description": "LLM \u9884\u4f30\u5269\u4f59\u5b8c\u6210\u65f6\u95f4\uff08\u5206\u949f\uff09"
    },
    "total_elapsed_minutes": {
      "type": "number",
      "description": "\u4ece\u5230\u8fbe\u5230\u73b0\u5728\u5df2\u8017\u65f6\uff08\u5206\u949f\uff09"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stalled",
        "pending_manager_closure",
        "closed"
      ],
      "default": "active",
      "description": "\u5feb\u7167\u72b6\u6001\uff08\u4e0d\u53ef\u53d8\u5feb\u7167\u7b56\u7565\u4e0b\uff0c\u65b0\u7248\u672c\u5feb\u7167\u7531\u63d0\u4ea4\u521b\u5efa\uff1b\u72b6\u6001\u6743\u5a01\u4ee5 Workflow.status \u4e3a\u51c6\uff09"
    },
    "pipeline_trigger": {
      "type": "string",
      "enum": [
        "session_stalled",
        "node_completed",
        "staff_report",
        "manual"
      ],
      "description": "\u672c\u6b21 Pipeline \u538b\u7f29\u7684\u89e6\u53d1\u539f\u56e0"
    },
    "audit_log_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u652f\u6491\u672c\u5feb\u7167\u7684 AuditLog event_id \u5217\u8868\uff08\u4fdd\u7559\u517c\u5bb9\uff1b\u89c4\u8303\u5b57\u6bb5\u4e3a audit_event_ids\uff09"
    },
    "attention_item_id": {
      "type": "string",
      "description": "\u82e5\u672c\u5feb\u7167\u89e6\u53d1\u4e86 AttentionItem\uff0c\u8bb0\u5f55\u5176 ID"
    },
    "manager_closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u5e97\u957f\u6267\u884c\u6700\u7ec8\u95ed\u73af\u786e\u8ba4\u7684\u65f6\u95f4"
    },
    "manager_note": {
      "type": "string",
      "description": "\u5e97\u957f\u95ed\u73af\u5907\u6ce8"
    },
    "reconciled": {
      "type": "boolean",
      "default": false,
      "description": "V10.1 \u6838\u9500\u5165\u5e93\u6807\u8bb0\uff1a\u5df2\u95ed\u73af\uff08status=closed\uff09\u5de5\u4f5c\u6d41\u7ecf\u5e97\u957f\u5ba1\u6838\u786e\u8ba4\u5165\u5e93\u540e\u7f6e\u4e3a true\u3002false \u8868\u793a\u5df2\u95ed\u73af\u4f46\u5c1a\u672a\u6838\u9500\u5165\u5e93\uff0c\u8fdb\u5165\u6279\u91cf\u6838\u9500\u5f85\u529e\u3002"
    },
    "reconciled_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u5e97\u957f\u6267\u884c\u6838\u9500\u5165\u5e93\u7684\u65f6\u95f4"
    },
    "reconciled_by": {
      "type": "string",
      "description": "\u6267\u884c\u6838\u9500\u5165\u5e93\u7684\u5e97\u957f\u7528\u6237/\u5458\u5de5 ID"
    },
    "reconcile_note": {
      "type": "string",
      "description": "\u5e97\u957f\u6838\u9500\u5165\u5e93\u5907\u6ce8\uff08\u53ef\u9009\uff09"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u672c\u6b21\u5feb\u7167\u751f\u6210\u65f6\u95f4"
    },
    "snapshot_version": {
      "type": "number",
      "default": 1,
      "description": "\u4e50\u89c2\u5e76\u53d1\u7248\u672c\u53f7\uff1a\u5e97\u957f\u6267\u884c\u63d0\u6848\u65f6\u6bd4\u5bf9\uff1b\u53d8\u5316\u5219\u6807\u8bb0 STALE_PROPOSAL \u91cd\u65b0\u9a8c\u8bc1\uff08\u4e0d\u53ef\u53d8\u5feb\u7167\u7b56\u7565\uff1a\u63d0\u4ea4\u521b\u5efa\u7248\u672c+1 \u7684\u65b0\u5feb\u7167\uff0c\u4e0d\u539f\u5730\u8986\u76d6\uff09"
    },
    "projection_version": {
      "type": "number",
      "default": 1,
      "description": "\u6295\u5f71\u7248\u672c\uff1a\u672c\u6b21 Workflow \u6295\u5f71\u7684\u7248\u672c"
    },
    "projected_through_event_seq": {
      "type": "number",
      "description": "\u672c\u5feb\u7167\u6295\u5f71\u5df2\u5904\u7406\u5230\u7684\u4e8b\u4ef6\u5e8f\u53f7\u6c34\u4f4d"
    },
    "source_proposal_id": {
      "type": "string",
      "description": "\u751f\u6210\u672c\u5feb\u7167\u7684\u63d0\u6848\u5e42\u7b49\u952e\uff0c\u5fc5\u987b\u552f\u4e00"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u652f\u6491\u672c\u5feb\u7167\u7684\u539f\u59cb Artifact ID \u5217\u8868\uff08\u89c4\u8303\u5b57\u6bb5\uff0c\u52ff\u5199\u5165 audit_log_ids\uff09"
    },
    "evidence_fact_card_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u652f\u6491\u672c\u5feb\u7167\u7684 EvidenceFactCard ID \u5217\u8868"
    },
    "audit_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u652f\u6491\u672c\u5feb\u7167\u7684 AuditLog event_id \u5217\u8868\uff08\u89c4\u8303\u5b57\u6bb5\uff09"
    },
    "manager_decision_id": {
      "type": "string",
      "description": "\u89e6\u53d1\u672c\u5feb\u7167\u72b6\u6001\u53d8\u5316\u7684 ManagerDecision ID\uff08\u552f\u4e00\u9a71\u52a8\u8def\u5f84\uff09"
    },
    "composition_run_id": {
      "type": "string",
      "description": "\u751f\u6210\u672c\u5feb\u7167\u7684 CompositionRun ID"
    }
  },
  "required": [
    "clinic_id",
    "session_id",
    "business_line",
    "start_time",
    "status",
    "generated_at"
  ]
}