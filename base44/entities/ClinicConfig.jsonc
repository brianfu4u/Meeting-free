{
  "name": "ClinicConfig",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u4e25\u683c Tenant \u903b\u8f91\u9694\u79bb\u5b57\u6bb5\uff0c\u4e3b\u952e"
    },
    "clinic_name": {
      "type": "string",
      "description": "\u95e8\u5e97\u540d\u79f0"
    },
    "city": {
      "type": "string",
      "description": "\u6240\u5728\u57ce\u5e02"
    },
    "contact": {
      "type": "string",
      "description": "\u8054\u7cfb\u4eba"
    },
    "manager_id": {
      "type": "string",
      "description": "\u5e97\u957f\u5458\u5de5ID"
    },
    "wait_timeout_yellow_minutes": {
      "type": "number",
      "default": 15,
      "description": "\u5019\u8bca\u9ec4\u8272\u544a\u8b66\u9608\u503c\uff08\u5206\u949f\uff09"
    },
    "wait_timeout_red_minutes": {
      "type": "number",
      "default": 30,
      "description": "\u5019\u8bca\u7ea2\u8272\u544a\u8b66\u9608\u503c\uff08\u5206\u949f\uff09"
    },
    "stall_timeout_minutes": {
      "type": "number",
      "default": 60,
      "description": "\u8282\u70b9\u5361\u6ede\u8d85\u65f6\u9608\u503c\uff08\u5206\u949f\uff09"
    },
    "inventory_check_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "08:00",
        "20:00"
      ],
      "description": "\u5e93\u5b58\u53cc\u8282\u70b9\u68c0\u67e5\u65f6\u95f4"
    },
    "llm_task_draft_interval_minutes": {
      "type": "number",
      "default": 60,
      "description": "LLM\u4efb\u52a1\u8349\u6848\u751f\u6210\u95f4\u9694\uff08\u5206\u949f\uff09"
    },
    "llm_patrol_interval_minutes": {
      "type": "number",
      "default": 30,
      "description": "LLM\u5168\u5c97\u5de1\u68c0\u95f4\u9694\uff08\u5206\u949f\uff09"
    },
    "activation_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "deploying"
      ],
      "default": "active",
      "description": "\u95e8\u5e97\u6fc0\u6d3b\u72b6\u6001"
    },
    "cold_start_completed": {
      "type": "boolean",
      "default": false,
      "description": "\u51b7\u542f\u52a8\u6570\u636e\u5f55\u5165\u662f\u5426\u5b8c\u6210"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Tokyo",
      "description": "\u95e8\u5e97\u4e1a\u52a1\u65f6\u533a\uff0c\u7528\u4e8e\u4e1a\u52a1\u65e5\u671f\u4e0e\u5b9a\u65f6\u8fd0\u884c\u8ba1\u7b97"
    },
    "schedule_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "12:30",
        "15:30",
        "17:30"
      ],
      "description": "CompositionRun \u5b9a\u65f6\u7f16\u7ec4\u65f6\u6bb5\u5217\u8868"
    },
    "shadow_mode": {
      "type": "boolean",
      "default": true,
      "description": "\u5f71\u5b50\u6a21\u5f0f\uff1a\u6240\u6709\u63d0\u6848\u53ea\u8bfb\uff0cAI\u4e0d\u5f97\u76f4\u63a5\u4fee\u6539\u6838\u5fc3\u72b6\u6001"
    },
    "active_policy_version": {
      "type": "number",
      "description": "\u5f53\u524d\u751f\u6548\u7684 GuessPolicy \u7248\u672c"
    },
    "publish_lock_request_id": {
      "type": "string",
      "description": "\u53d1\u5e03\u4e92\u65a5\u9501\uff1a\u5f53\u524d\u6301\u6709 GuessPolicy \u53d1\u5e03\u4e34\u754c\u533a\u7684\u5e42\u7b49\u952e\uff0cnull=\u7a7a\u95f2\u3002\u57fa\u4e8e ClinicConfig \u5355\u6587\u6863 updateMany CAS \u539f\u5b50\u83b7\u53d6\uff0c\u4fdd\u8bc1 clinic \u7ea7\u53d1\u5e03\u4e92\u65a5\uff0c\u66ff\u4ee3 created_date \u4e50\u89c2\u542f\u53d1\u3002"
    }
  },
  "required": [
    "clinic_id",
    "clinic_name"
  ]
}