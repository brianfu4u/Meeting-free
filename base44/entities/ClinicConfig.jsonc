{
  "name": "ClinicConfig",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "门店唯一标识，严格 Tenant 逻辑隔离字段，主键"
    },
    "clinic_name": {
      "type": "string",
      "description": "门店名称"
    },
    "city": {
      "type": "string",
      "description": "所在城市"
    },
    "contact": {
      "type": "string",
      "description": "联系人"
    },
    "manager_id": {
      "type": "string",
      "description": "店长员工ID"
    },
    "wait_timeout_yellow_minutes": {
      "type": "number",
      "default": 15,
      "description": "候诊黄色告警阈值（分钟）"
    },
    "wait_timeout_red_minutes": {
      "type": "number",
      "default": 30,
      "description": "候诊红色告警阈值（分钟）"
    },
    "stall_timeout_minutes": {
      "type": "number",
      "default": 60,
      "description": "节点卡滞超时阈值（分钟）"
    },
    "inventory_check_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "08:00",
        "20:00"
      ],
      "description": "库存双节点检查时间"
    },
    "llm_task_draft_interval_minutes": {
      "type": "number",
      "default": 60,
      "description": "LLM任务草案生成间隔（分钟）"
    },
    "llm_patrol_interval_minutes": {
      "type": "number",
      "default": 30,
      "description": "LLM全岗巡检间隔（分钟）"
    },
    "activation_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "deploying"
      ],
      "default": "active",
      "description": "门店激活状态"
    },
    "cold_start_completed": {
      "type": "boolean",
      "default": false,
      "description": "冷启动数据录入是否完成"
    },
    "timezone": {
      "type": "string",
      "default": "Asia/Tokyo",
      "description": "门店业务时区，用于业务日期与定时运行计算"
    },
    "schedule_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "12:30",
        "15:30",
        "17:30"
      ],
      "description": "CompositionRun 定时编组时段列表"
    },
    "shadow_mode": {
      "type": "boolean",
      "default": true,
      "description": "影子模式：所有提案只读，AI不得直接修改核心状态"
    },
    "active_policy_version": {
      "type": "number",
      "description": "当前生效的 GuessPolicy 版本"
    },
    "publish_lock_owner_id": {
      "type": "string",
      "description": "发布锁持有者：每个实际请求生成的唯一 UUID（lock_owner_id），与业务 idempotency_key 严格分离。null=空闲。基于 ClinicConfig 单文档 updateMany CAS（过滤 publish_lock_owner_id=null）原子获取，由 updated===1 判定成功。"
    },
    "publish_lock_acquired_at": {
      "type": "string",
      "format": "date-time",
      "description": "锁获取时刻（ISO），配合 expires_at 实现短租约与过期接管。"
    },
    "publish_lock_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "锁过期时刻（ISO）：过期后可被原子接管（CAS 过滤原 owner+expires_at 精确值），保证函数崩溃不会永久锁死门店。"
    },
    "composition_run_lock_key": {
      "type": "string",
      "description": "CompositionRun 创建锁对应的 idempotency_key；与 Policy 发布锁隔离。"
    },
    "composition_run_lock_owner_id": {
      "type": "string",
      "description": "CompositionRun 创建短租约持有者。null=空闲；通过 updateMany updated===1 判断 CAS 成功。"
    },
    "composition_run_lock_acquired_at": {
      "type": "string",
      "format": "date-time",
      "description": "CompositionRun 创建锁获取时间。"
    },
    "composition_run_lock_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "CompositionRun 创建锁过期时间；过期后允许精确 owner/key/expires CAS 接管。"
    }
  },
  "required": [
    "clinic_id",
    "clinic_name"
  ]
}