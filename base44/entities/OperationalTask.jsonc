{
  "name": "OperationalTask",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "attention_item_id": {
      "type": "string",
      "description": "V10\u5baa\u6cd5\u6eaf\u6e90\u5b57\u6bb5\uff1a\u6bcf\u4e2aTask\u5fc5\u987b\u6765\u81ea\u4e00\u4e2a\u5e97\u957f\u5df2\u6279\u51c6\u7684AttentionItem\uff08staff_self\u9664\u5916\uff09"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "default": "P4",
      "description": "\u4f18\u5148\u7ea7\uff1aP1\u5e97\u957f\u6307\u4ee4/P2\u60a3\u8005\u6d41\u7d27\u8feb/P3\u6628\u65e5\u9057\u7559/P4\u5e38\u89c4\u8ba1\u5212"
    },
    "dispatched_by": {
      "type": "string",
      "enum": [
        "manager",
        "staff_self"
      ],
      "description": "V10\u5baa\u6cd5\uff1a\u4efb\u52a1\u53ea\u80fd\u7531manager\uff08\u5e97\u957f\u51b3\u7b56\u540e\uff09\u6216staff_self\uff08\u5458\u5de5\u81ea\u4e3b\uff09\u53d1\u8d77\u3002AI\u4e0d\u518d\u76f4\u63a5\u521b\u5efa\u4efb\u52a1\u3002"
    },
    "assignee_staff_id": {
      "type": "string",
      "description": "\u6307\u6d3e\u5458\u5de5ID"
    },
    "description": {
      "type": "string",
      "description": "\u4efb\u52a1\u63cf\u8ff0"
    },
    "patient_session_id": {
      "type": "string",
      "description": "\u951a\u5b9aPatientSession\u56e0\u679c\u94fe\uff0c\u60a3\u8005\u76f8\u5173\u4efb\u52a1\u5fc5\u586b\uff0c\u975e\u60a3\u8005\u4efb\u52a1\u53ef\u7a7a"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "assigned",
        "in_progress",
        "pending_evidence",
        "under_review",
        "exception",
        "completed"
      ],
      "default": "pending_approval",
      "description": "\u4efb\u52a1\u72b6\u6001\u673a"
    },
    "due_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u622a\u6b62\u65f6\u95f4"
    },
    "current_version_id": {
      "type": "string",
      "description": "\u5f53\u524d\u8bc1\u636e\u7248\u672cID\uff0c\u5e97\u957f\u62d2\u7edd\u540e\u9012\u589e"
    },
    "total_submission_count": {
      "type": "number",
      "default": 0,
      "description": "\u8de8\u6240\u6709\u7248\u672c\u7d2f\u8ba1\u63d0\u4ea4\u6b21\u6570"
    },
    "llm_prereview_conclusion": {
      "type": "string",
      "description": "LLM EvidenceEvalSkill\u9884\u5ba1\u7ed3\u8bba\uff08\u4ec5\u4f9b\u53c2\u8003\uff0c\u4e0d\u4ee3\u8868\u6700\u7ec8\u51b3\u7b56\uff09"
    },
    "manager_decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "ignored"
      ],
      "description": "\u5e97\u957f\u4e09\u9009\u4e00\u51b3\u7b56"
    },
    "report_attachments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "\u5458\u5de5\u53d1\u8d77/\u6c47\u62a5\u65f6\u9644\u5e26\u7684\u591a\u6a21\u6001\u9644\u4ef6 [{type,url,name,transcript}]"
    },
    "ai_parsed": {
      "type": "object",
      "description": "V10\uff1a\u4ec5\u4f5c\u4e3a\u53c2\u8003\u4fe1\u606f\u5b58\u6863\uff0c\u4e0d\u518d\u9a71\u52a8\u81ea\u52a8\u5316\u52a8\u4f5c {category,urgency,summary,suggested_action}"
    },
    "report_log": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "\u4e8b\u4ef6\u6d41\uff1a\u6bcf\u6b21\u6c47\u62a5\uff08\u53d1\u8d77/\u8fdb\u5c55/\u6838\u9500\uff09\u8ffd\u52a0\u4e00\u6761 [{type,text,attachments,parsed,timestamp,staff_name}]"
    }
  },
  "required": [
    "clinic_id",
    "priority",
    "description",
    "status",
    "dispatched_by"
  ]
}