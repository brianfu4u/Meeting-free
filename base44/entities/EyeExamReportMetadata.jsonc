{
  "name": "EyeExamReportMetadata",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "兼容镜像；新编组代码读取 core_routing_fields.clinic_id"
    },
    "patient_id": {
      "type": "string",
      "description": "兼容镜像；不从报告内容猜测患者身份"
    },
    "raw_artifact_id": {
      "type": "string",
      "description": "来源原始 Artifact ID，作为解析幂等锚点"
    },
    "origin_evidence_item_id": {
      "type": "string",
      "description": "若来源于 EvidenceItem 桥接，记录原始 EvidenceItem ID"
    },
    "evidence_fact_card_id": {
      "type": "string",
      "description": "关联 EvidenceFactCard ID；仅 core_routing_fields 会投影到 FactCard"
    },
    "schema_version": {
      "type": "string",
      "description": "统一眼科检查报告元数据模型版本"
    },
    "layer_contract_version": {
      "type": "string",
      "description": "基础编组层与增值详细层的统一契约版本"
    },
    "record_kind": {
      "type": "string",
      "enum": ["exam_data_record"]
    },
    "core_routing_fields": {
      "type": "object",
      "description": "基础编组层。编组 Agent 唯一允许读取的元数据层，不含左右眼测量值或设备详细参数。",
      "properties": {
        "metadata_domain": { "type": "string", "enum": ["eye_exam"] },
        "exam_type": { "type": "string" },
        "exam_item_name": { "type": "string" },
        "event_type": { "type": "string" },
        "event_title": { "type": "string" },
        "clinic_id": { "type": "string" },
        "patient_id": { "type": "string" },
        "department": { "type": "string" },
        "role": { "type": "string" },
        "occurred_at": { "type": "string" },
        "reported_at": { "type": "string" },
        "basic_summary": { "type": "string" },
        "item_tag": { "type": "string" },
        "priority_hint": { "type": "string" },
        "sla_target_minutes": { "type": "number" },
        "requires_reupload": { "type": "boolean", "default": false }
      },
      "required": ["metadata_domain", "exam_type", "exam_item_name", "clinic_id", "occurred_at", "basic_summary"]
    },
    "value_add_fields": {
      "type": "object",
      "description": "增值详细层。供电子病历合成、检查纵览、趋势分析和质量报表使用，不参与基础编组。",
      "properties": {
        "device_context": {
          "type": "object",
          "properties": {
            "device_vendor": { "type": "string" },
            "device_model": { "type": "string" }
          },
          "additionalProperties": false
        },
        "report_key_values": {
          "type": "object",
          "additionalProperties": true,
          "description": "报告级详细参数，例如 PD、VD"
        },
        "eye_side_results": {
          "type": "object",
          "description": "左右眼详细测量值；仅记录数据，不评价是否正常",
          "properties": {
            "right": {
              "type": "object",
              "properties": {
                "raw_text": { "type": "string" },
                "key_values": { "type": "object", "additionalProperties": true },
                "raw_measurements": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
              },
              "additionalProperties": false
            },
            "left": {
              "type": "object",
              "properties": {
                "raw_text": { "type": "string" },
                "key_values": { "type": "object", "additionalProperties": true },
                "raw_measurements": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["device_context", "report_key_values", "eye_side_results"],
      "additionalProperties": false
    },
    "routing_status": {
      "type": "string",
      "enum": ["routing_ready", "routing_partial", "routing_blocked"]
    },
    "value_add_status": {
      "type": "string",
      "enum": ["value_add_complete", "value_add_partial", "value_add_unavailable"]
    },
    "routing_ready": { "type": "boolean" },
    "missing_routing_fields": { "type": "array", "items": { "type": "string" }, "default": [] },
    "missing_value_add_fields": { "type": "array", "items": { "type": "string" }, "default": [] },

    "exam_type": { "type": "string", "description": "兼容镜像；新代码读取 core_routing_fields.exam_type" },
    "exam_item_name": { "type": "string", "description": "兼容镜像；新代码读取 core_routing_fields.exam_item_name" },
    "exam_item_suggested_tag": { "type": "string" },
    "exam_item_manual_tag": { "type": "string" },
    "exam_item_manual_label": { "type": "string" },
    "exam_item_manual_note": { "type": "string" },
    "exam_item_confirmed_at": { "type": "string", "format": "date-time" },
    "exam_item_confirmed_by_staff_id": { "type": "string" },
    "requires_exam_item_confirmation": { "type": "boolean", "default": false },
    "department": { "type": "string" },
    "role": { "type": "string" },
    "occurred_at": { "type": "string" },
    "reported_at": { "type": "string" },
    "basic_summary": { "type": "string" },
    "device_vendor": { "type": "string", "description": "兼容镜像；增值服务读取 value_add_fields.device_context.device_vendor" },
    "device_model": { "type": "string", "description": "兼容镜像；增值服务读取 value_add_fields.device_context.device_model" },
    "measured_at": { "type": "string" },
    "report_key_values": { "type": "object", "additionalProperties": true, "description": "兼容镜像；增值服务读取 value_add_fields.report_key_values" },
    "eye_side_results": { "type": "object", "additionalProperties": true, "description": "兼容镜像；增值服务读取 value_add_fields.eye_side_results" },
    "parser_id": { "type": "string" },
    "parser_version": { "type": "string" },
    "template_id": { "type": "string" },
    "template_version": { "type": "string" },
    "template_match_score": { "type": "number" },
    "ocr_quality_score": { "type": "number" },
    "ocr_quality_flag": { "type": "string", "enum": ["good", "borderline", "poor"] },
    "ocr_quality_reasons": { "type": "array", "items": { "type": "string" }, "default": [] },
    "requires_reupload": { "type": "boolean", "default": false },
    "parse_status": { "type": "string", "enum": ["parsed", "partial", "fallback"] },
    "parse_confidence": { "type": "number" },
    "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
    "raw_text_excerpt": { "type": "string" },
    "disclaimer": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "clinic_id",
    "raw_artifact_id",
    "schema_version",
    "layer_contract_version",
    "record_kind",
    "core_routing_fields",
    "value_add_fields",
    "routing_status",
    "value_add_status",
    "routing_ready",
    "exam_type",
    "eye_side_results",
    "parser_id",
    "parser_version",
    "parse_status",
    "parse_confidence",
    "disclaimer",
    "created_at"
  ]
}
