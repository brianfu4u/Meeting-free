{
  "name": "EvidenceItem",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "task_id": {
      "type": "string",
      "description": "\u5173\u8054OperationalTask ID\uff08\u65b0\u4e8b\u4ef6\u81ea\u4e3b\u6c47\u62a5\u65f6\u53ef\u7a7a\uff09"
    },
    "version_id": {
      "type": "string",
      "description": "\u8bc1\u636e\u7248\u672cID\uff0c\u5bf9\u5e94\u4efb\u52a1current_version_id"
    },
    "submission_count": {
      "type": "number",
      "default": 1,
      "description": "\u5f53\u524d\u7248\u672c\u63d0\u4ea4\u6b21\u6570\uff08\u6700\u591a3\u6b21\uff09"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "image",
        "screenshot",
        "voice",
        "file"
      ],
      "description": "\u8bc1\u636e\u7c7b\u578b"
    },
    "file_url": {
      "type": "string",
      "description": "\u8bc1\u636e\u6587\u4ef6URL"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u63d0\u4ea4\u65f6\u95f4"
    },
    "submitted_by": {
      "type": "string",
      "description": "\u63d0\u4ea4\u5458\u5de5ID"
    },
    "eval_result": {
      "type": "string",
      "enum": [
        "pending",
        "qualified",
        "insufficient",
        "unqualified"
      ],
      "default": "pending",
      "description": "EvidenceEvalSkill\u8bc4\u4f30\u7ed3\u679c"
    },
    "eval_notes": {
      "type": "string",
      "description": "\u8bc4\u4f30\u5907\u6ce8/\u7f3a\u5931\u8bf4\u660e"
    },
    "bridge_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "converted",
        "failed"
      ],
      "default": "pending",
      "description": "\u65b9\u5411A\u5b9e\u65f6\u6865\u63a5\u72b6\u6001\uff1apending\u2192processing\u2192converted/failed"
    },
    "attempt_count": {
      "type": "number",
      "default": 0,
      "description": "EvidenceItem\u6865\u63a5\u5c1d\u8bd5\u6b21\u6570\uff0c\u6700\u591a3\u6b21"
    },
    "last_error_code": {
      "type": "string",
      "description": "\u6700\u8fd1\u4e00\u6b21\u6865\u63a5\u5931\u8d25\u7684\u8131\u654f\u9519\u8bef\u7801\uff1b\u6210\u529f\u540e\u6e05\u7a7a"
    }
  },
  "required": [
    "clinic_id",
    "version_id",
    "evidence_type",
    "file_url",
    "submitted_at",
    "submitted_by"
  ]
}
