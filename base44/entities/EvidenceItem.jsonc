{"name":"EvidenceItem","type":"object","properties":{"clinic_id":{"type":"string","description":"门店唯一标识，宪法级物理隔离字段"},"task_id":{"type":"string","description":"关联OperationalTask ID（新事件自主汇报时可空）"},"version_id":{"type":"string","description":"证据版本ID，对应任务current_version_id"},"submission_count":{"type":"number","default":1,"description":"当前版本提交次数（最多3次）"},"evidence_type":{"type":"string","enum":["image","screenshot","voice","file"],"description":"证据类型"},"file_url":{"type":"string","description":"证据文件URL"},"submitted_at":{"type":"string","format":"date-time","description":"提交时间"},"submitted_by":{"type":"string","description":"提交员工ID"},"eval_result":{"type":"string","enum":["pending","qualified","insufficient","unqualified"],"default":"pending","description":"EvidenceEvalSkill评估结果"},"eval_notes":{"type":"string","description":"评估备注/缺失说明"},"bridge_status":{"type":"string","enum":["pending","processing","converted","failed"],"default":"pending","description":"方向A实时桥接状态：pending→processing→converted/failed"},"attempt_count":{"type":"number","default":0,"description":"EvidenceItem桥接尝试次数，最多3次"},"last_error_code":{"type":"string","description":"最近一次桥接失败的脱敏错误码；成功后清空"}},"required":["clinic_id","version_id","evidence_type","file_url","submitted_at","submitted_by"]}
