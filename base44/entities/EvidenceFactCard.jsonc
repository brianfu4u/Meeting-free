{"name":"EvidenceFactCard","type":"object","properties":{"clinic_id":{"type":"string","description":"门店唯一标识，严格 Tenant 逻辑隔离字段"},"artifact_id":{"type":"string","description":"来源 Artifact ID（1:1 缓存锚点）"},"origin_evidence_item_id":{"type":"string","description":"方向A实时桥接来源 EvidenceItem ID；与 Artifact/FragmentProcessingResult 形成完整溯源链"},"fields":{"type":"array","items":{"type":"object","properties":{"field_name":{"type":"string","description":"字段名（如 exam_result/lens_power/patient_complaint）"},"value":{"type":"string","description":"字段提取值"},"source_artifact_id":{"type":"string","description":"该字段来源 Artifact ID（字段级溯源）"},"source_region":{"type":"string","description":"来源区域/坐标"},"source_quote":{"type":"string","description":"来源原文/引用"},"extraction_quality":{"type":"string","enum":["high","medium","low","uncertain"],"description":"字段级提取质量"},"extraction_method":{"type":"string","description":"提取方法（ocr/voice_transcribe/llm_parse/manual）"}},"required":["field_name","value","source_artifact_id","extraction_quality","extraction_method"]},"default":[],"description":"字段级溯源数组"},"business_date":{"type":"string","format":"date","description":"业务日期"},"session_id":{"type":"string","description":"推断关联的 PatientSession ID（可空）"},"extracted_at":{"type":"string","format":"date-time","description":"提取时间（仅记录解读时刻，非业务时间）"},"model_version":{"type":"string","description":"Interpreter 使用的 LLM 模型版本"},"prompt_version":{"type":"string","description":"Interpreter Prompt 版本"},"policy_version":{"type":"number","description":"生成时生效的 GuessPolicy 版本"},"stale":{"type":"boolean","default":false,"description":"源 Artifact 变更后本缓存是否失效"},"explicit_workflow_id":{"type":"string","description":"Phase 3：显式绑定 Workflow ID（来自 Artifact.source_workflow_id）"},"workflow_family_hint":{"type":"string","description":"Phase 3：LLM 推断的工作流业务族提示（Clustering new_train 分组依据）"},"subject_type":{"type":"string","description":"Phase 3：主体类型（patient/supplier/staff/unknown 等）"},"subject_fingerprint":{"type":"object","description":"Phase 3：主体指纹（如 {name}），subject_conflict 硬护栏比对依据","properties":{"name":{"type":"string"}},"additionalProperties":true},"device_serial":{"type":"string","description":"Explicit device identity used by Agent v1.1 hard-conflict validation"},"subject_quality":{"type":"string","enum":["high","medium","low","uncertain"],"description":"Phase 3：主体识别质量"},"occurred_at":{"type":"string","format":"date-time","description":"Phase 3：业务发生时间。无法确定时为 null，且 time_uncertain=true。"},"confidence":{"type":"number","description":"Phase 5：对齐置信度（0–1），由 alignment 层产出。"},"evidence_spans":{"type":"array","items":{"type":"object","additionalProperties":true},"default":[],"description":"Phase 5：证据片段数组（文本+位置，如 page/offset/region/timestamp_start_ms）。"},"contradictions":{"type":"array","items":{"type":"string"},"default":[],"description":"Phase 5：LLM 检测到的矛盾清单。"},"unsupported_assumptions":{"type":"array","items":{"type":"string"},"default":[],"description":"Phase 5：LLM 标注的无依据假设清单。"},"interpreter_version":{"type":"string","description":"Phase 5：Interpreter 版本（对齐层产出）。"},"time_uncertain":{"type":"boolean","default":false,"description":"Phase 5：业务时间不确定标记。occurred_at=null 时必须为 true。"},"alignment_status":{"type":"string","enum":["aligned","needs_clarification","rejected","failed"],"description":"Phase 5：对齐状态。aligned=可送入 Agent，needs_clarification=需补充，rejected/failed=不送入。"},"assembly_eligible":{"type":"boolean","default":false,"description":"Phase 5：是否可送入 Composition Agent。仅 aligned 且结构合法时为 true。"},"processing_result_id":{"type":"string","description":"Phase 5：关联 FragmentProcessingResult ID。"},"marquee_label":{"type":"string","description":"V11 走马灯通道：SemanticReconstructionSkill 产出的走马灯展示文本（业务族·主体·首字段值）。仅 aligned 时填写，走马灯组件直接绑定本字段播放。"},"marquee_urgency":{"type":"string","enum":["green","yellow","red"],"description":"V11 走马灯通道：展示紧急度（green/yellow/red），由 Skill 按对齐质量/矛盾推断。"}},"required":["clinic_id","artifact_id","business_date","extracted_at"]}
