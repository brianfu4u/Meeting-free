{
  "name": "EvidenceFactCard",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u4e25\u683c Tenant \u903b\u8f91\u9694\u79bb\u5b57\u6bb5"
    },
    "artifact_id": {
      "type": "string",
      "description": "\u6765\u6e90 Artifact ID\uff081:1 \u7f13\u5b58\u951a\u70b9\uff09"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_name": {
            "type": "string",
            "description": "\u5b57\u6bb5\u540d\uff08\u5982 exam_result/lens_power/patient_complaint\uff09"
          },
          "value": {
            "type": "string",
            "description": "\u5b57\u6bb5\u63d0\u53d6\u503c"
          },
          "source_artifact_id": {
            "type": "string",
            "description": "\u8be5\u5b57\u6bb5\u6765\u6e90 Artifact ID\uff08\u5b57\u6bb5\u7ea7\u6eaf\u6e90\uff09"
          },
          "source_region": {
            "type": "string",
            "description": "\u6765\u6e90\u533a\u57df/\u5750\u6807\uff08\u56fe\u50cf\u533a\u57df\u6216\u6587\u672c\u5b9a\u4f4d\uff09"
          },
          "source_quote": {
            "type": "string",
            "description": "\u6765\u6e90\u539f\u6587/\u5f15\u8ff0\uff08\u4e0e source_region \u4e8c\u9009\u4e00\u6216\u4e92\u8865\uff09"
          },
          "extraction_quality": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "uncertain"
            ],
            "description": "\u5b57\u6bb5\u7ea7\u63d0\u53d6\u8d28\u91cf\uff0c\u4e0d\u5f97\u7528\u5355\u4e00\u603b\u4f53 confidence \u66ff\u4ee3"
          },
          "extraction_method": {
            "type": "string",
            "description": "\u63d0\u53d6\u65b9\u6cd5\uff08\u5982 ocr/voice_transcribe/llm_parse/manual\uff09"
          }
        },
        "required": [
          "field_name",
          "value",
          "source_artifact_id",
          "extraction_quality",
          "extraction_method"
        ]
      },
      "default": [],
      "description": "\u5b57\u6bb5\u7ea7\u6eaf\u6e90\u6570\u7ec4\uff1a\u6bcf\u4e2a\u5b57\u6bb5\u72ec\u7acb\u6807\u6ce8\u6765\u6e90\u4e0e\u8d28\u91cf"
    },
    "business_date": {
      "type": "string",
      "format": "date",
      "description": "\u4e1a\u52a1\u65e5\u671f"
    },
    "session_id": {
      "type": "string",
      "description": "\u63a8\u5bfc\u5173\u8054\u7684 PatientSession ID\uff08\u53ef\u7a7a\uff09"
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u63d0\u53d6\u65f6\u95f4"
    },
    "model_version": {
      "type": "string",
      "description": "Interpreter \u4f7f\u7528\u7684 LLM \u6a21\u578b\u7248\u672c"
    },
    "prompt_version": {
      "type": "string",
      "description": "Interpreter Prompt \u7248\u672c"
    },
    "policy_version": {
      "type": "number",
      "description": "\u751f\u6210\u65f6\u751f\u6548\u7684 GuessPolicy \u7248\u672c"
    },
    "stale": {
      "type": "boolean",
      "default": false,
      "description": "\u6e90 Artifact \u53d8\u66f4\u540e\u672c\u7f13\u5b58\u662f\u5426\u5931\u6548"
    }
  },
  "required": [
    "clinic_id",
    "artifact_id",
    "business_date",
    "extracted_at"
  ]
}