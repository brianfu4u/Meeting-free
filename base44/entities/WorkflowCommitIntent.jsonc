{
  "name": "WorkflowCommitIntent",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "manager_execution_idempotency_key": {
      "type": "string",
      "description": "\u63d0\u4ea4\u5e42\u7b49\u952e = manager_decision_id + proposal_id\uff08\u6765\u81ea Phase 2 tenantContext.computeManagerExecutionIdempotencyKey\uff09\uff1b\u76f8\u540c\u952e\u91cd\u653e\u547d\u4e2d\u65e2\u6709 Intent"
    },
    "manager_decision_id": {
      "type": "string",
      "description": "\u5173\u8054 ManagerDecision ID\uff08\u63d0\u4ea4\u8fc7\u7a0b\u4e2d\u521b\u5efa\uff0cfinalize \u9636\u6bb5\u7f6e\u7ec8\u6001\uff09"
    },
    "attention_item_id": {
      "type": "string",
      "description": "\u89e6\u53d1\u672c\u6b21\u63d0\u4ea4\u7684 AttentionItem ID\uff08\u5e97\u957f execute \u51b3\u7b56\u6765\u6e90\uff09"
    },
    "selected_hypothesis_id": {
      "type": "string",
      "description": "\u672c\u6b21\u63d0\u4ea4\u9009\u5b9a\u7684 WorkflowHypothesis ID"
    },
    "target_workflow_id": {
      "type": "string",
      "description": "\u63d0\u4ea4\u76ee\u6807 Workflow ID"
    },
    "expected_snapshot_id": {
      "type": "string",
      "description": "\u5e97\u957f\u5ba1\u6838\u65f6\u770b\u5230\u7684 WorkflowSnapshot ID\uff08CAS \u6bd4\u5bf9\u57fa\u51c6\uff09"
    },
    "expected_snapshot_version": {
      "type": "number",
      "description": "\u5e97\u957f\u5ba1\u6838\u65f6\u770b\u5230\u7684\u5feb\u7167\u7248\u672c\uff08CAS \u6bd4\u5bf9 Workflow.current_snapshot_version\uff1b\u4e0d\u4e00\u81f4 \u2192 stale\uff09"
    },
    "new_snapshot_id": {
      "type": "string",
      "description": "\u63d0\u4ea4\u521b\u5efa\u7684\u65b0\u4e0d\u53ef\u53d8 WorkflowSnapshot ID\uff08\u4e0d\u53ef\u53d8\u5feb\u7167\u7b56\u7565\uff09"
    },
    "new_snapshot_version": {
      "type": "number",
      "description": "\u65b0\u5feb\u7167\u7248\u672c\u53f7 = expected_snapshot_version + 1"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "committing",
        "committed",
        "stale",
        "compensation_failed"
      ],
      "default": "pending",
      "description": "Saga \u72b6\u6001\u673a\uff1apending\u2192committing\u2192committed/stale/compensation_failed\uff1bBase44 \u65e0\u8de8 Entity \u4e8b\u52a1\uff0c\u6545\u4ee5 Saga + reconciliation \u66ff\u4ee3\u539f\u5b50\u63d0\u4ea4\u58f0\u660e"
    },
    "reconciliation": {
      "type": "object",
      "description": "\u5931\u8d25\u5bf9\u8d26\u4fe1\u606f\uff1a\u4e2d\u6bb5\u5931\u8d25\u65f6\u8f93\u51fa\u5df2\u6267\u884c\u6b65\u9aa4/\u5f85\u8865\u507f\u9879\uff0c\u652f\u6301\u5e42\u7b49\u91cd\u653e\uff1b\u4e0d\u5f97\u9759\u9ed8\u541e\u6389\u8865\u507f\u5931\u8d25",
      "properties": {
        "last_step": {
          "type": "string"
        },
        "executed_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pending_compensation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Intent \u521b\u5efa\u65f6\u95f4"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time",
      "description": "Intent \u7ec8\u6001\u65f6\u95f4\uff08committed/stale/compensation_failed\uff09"
    }
  },
  "required": [
    "clinic_id",
    "manager_execution_idempotency_key",
    "attention_item_id",
    "target_workflow_id",
    "expected_snapshot_id",
    "expected_snapshot_version",
    "status"
  ]
}