{"name":"FragmentProcessingResult","type":"object","properties":{"clinic_id":{"type":"string","description":"门店唯一标识，严格 Tenant 逻辑隔离字段"},"artifact_id":{"type":"string","description":"关联 Artifact ID（1:1）"},"origin_evidence_item_id":{"type":"string","description":"方向A实时桥接来源 EvidenceItem ID；用于与 Artifact/FactCard 贯通溯源和幂等"},"client_request_id":{"type":"string","description":"客户端幂等键"},"ingestion_key":{"type":"string","description":"clinic_id::client_request_id，查询索引"},"fragment_type":{"type":"string","enum":["image","document","audio","text"],"description":"碎片类型"},"adapter_name":{"type":"string","description":"处理 Adapter 名（image/document/audio/text）"},"adapter_version":{"type":"string","description":"Adapter 版本"},"status":{"type":"string","enum":["pending","processing","aligned","needs_clarification","failed","rejected"],"default":"pending","description":"处理状态机：pending→processing→aligned/needs_clarification/failed/rejected"},"extracted_text":{"type":"string","description":"Adapter 提取的归一化文本（OCR/文档解析/转写/原文清洗）。脱敏后保存。"},"transcript":{"type":"string","description":"AudioAdapter 专用：STT 转写全文。脱敏后保存。"},"language":{"type":"string","description":"检测到的语言（ISO-639-1，如 ja/en/zh）"},"duration_ms":{"type":"number","description":"音频时长（毫秒）"},"evidence_spans":{"type":"array","items":{"type":"object","additionalProperties":true},"default":[],"description":"证据片段数组（文本片段+位置，如 page/offset/region/timestamp）"},"parser_warnings":{"type":"array","items":{"type":"string"},"default":[],"description":"解析层告警码（脱敏，allowlist）"},"quality_issues":{"type":"array","items":{"type":"string"},"default":[],"description":"质量门槛告警码"},"fact_card_ids":{"type":"array","items":{"type":"string"},"default":[],"description":"生成的 EvidenceFactCard ID 列表"},"assembly_eligible":{"type":"boolean","default":false,"description":"是否具备送入 Composition Agent 的资格。仅 aligned 时为 true。"},"attempt_count":{"type":"number","default":0,"description":"尝试次数（含首次）"},"error_code":{"type":"string","description":"脱敏错误码（来自 ALLOWED_ERROR_CODES，不得包含原始异常/stack）"},"started_at":{"type":"string","format":"date-time","description":"处理开始时间"},"completed_at":{"type":"string","format":"date-time","description":"处理完成时间（aligned/needs_clarification/failed/rejected 时写入）"}},"required":["clinic_id","artifact_id","fragment_type","status"]}
