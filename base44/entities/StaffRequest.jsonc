{
  "name": "StaffRequest",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "support",
        "procurement",
        "repair",
        "activity",
        "leave"
      ],
      "description": "\u7533\u8bf7\u7c7b\u578b\uff1a\u8de8\u5c97\u652f\u63f4/\u91c7\u8d2d/\u62a5\u4fee/\u6d3b\u52a8\u5ba1\u6279/\u8bf7\u5047"
    },
    "requester_id": {
      "type": "string",
      "description": "\u53d1\u8d77\u5458\u5de5ID"
    },
    "target_staff_id": {
      "type": "string",
      "description": "\u652f\u63f4\u76ee\u6807\u5458\u5de5ID\uff08support\u7c7b\u578b\uff09"
    },
    "description": {
      "type": "string",
      "description": "\u7533\u8bf7\u63cf\u8ff0"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "yellow",
        "red"
      ],
      "default": "yellow",
      "description": "\u7d27\u6025\u7a0b\u5ea6"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "rejected",
        "ignored",
        "executing",
        "completed"
      ],
      "default": "pending_approval",
      "description": "\u7533\u8bf7\u72b6\u6001"
    },
    "evidence_item_id": {
      "type": "string",
      "description": "\u5173\u8054\u8bc1\u636e\u9879\uff08\u91c7\u8d2d/\u62a5\u4fee\u9700\u9644\u8bc1\u636e\u94fe\uff09"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u7533\u8bf7\u65f6\u95f4"
    }
  },
  "required": [
    "clinic_id",
    "request_type",
    "requester_id",
    "description",
    "status"
  ]
}