{
  "name": "Staff",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "user_id": {
      "type": "string",
      "description": "\u7ed1\u5b9a\u7ec8\u7aef\u767b\u5f55\u8d26\u53f7ID\uff08\u5e73\u53f0 User.id\uff09\u3002\u7ed1\u5b9a\u540e\u8be5\u767b\u5f55\u8d26\u53f7\u5373\u6b64\u5458\u5de5\uff0c\u7ec8\u7aef\u6309\u6b64\u5b57\u6bb5\u8bc6\u522b\u5f53\u524d\u4f7f\u7528\u4eba\u3002"
    },
    "staff_name": {
      "type": "string",
      "description": "\u5458\u5de5\u59d3\u540d"
    },
    "role": {
      "type": "string",
      "enum": [
        "doctor",
        "physician_asst",
        "optometrist",
        "optician",
        "vision_trainer",
        "imaging_tech",
        "diagnostic_staff",
        "surgeon",
        "or_nurse",
        "anesthesiologist",
        "nurse",
        "triage_staff",
        "reception",
        "crm_staff",
        "patient_guide",
        "marketing",
        "channel_dev",
        "screening_team",
        "cashier",
        "insurance_officer",
        "accountant",
        "pharmacist",
        "equipment_admin",
        "inventory_staff",
        "clinic_director",
        "qa_officer",
        "sanitation_staff"
      ],
      "description": "\u5c97\u4f4d\u89d2\u8272\uff08\u4f9d\u636e\u300a\u773c\u79d1\u8bca\u6240\u90e8\u95e8-\u5c97\u4f4d\u6620\u5c04\u89c4\u8303\u300bv1.2026-07-21\uff0c\u517127\u4e2a\u6807\u51c6\u5316\u5c97\u4f4d\uff09\u3002\u679a\u4e3e\u503c\u4e0e src/lib/departments/registry.js \u4e2d ALL_ROLES \u7684 id \u4e25\u683c\u5bf9\u9f50\u3002"
    },
    "role_group": {
      "type": "string",
      "enum": [
        "clinical",
        "non_clinical"
      ],
      "description": "\u5c97\u4f4d\u6240\u5c5e\u4e1a\u52a1\u65cf\uff1aclinical=\u4e34\u5e8a\u4e0e\u8bca\u7597\uff08\u90e8\u95e81-5\uff09/ non_clinical=\u8fd0\u8425\u4e0e\u652f\u6301\uff08\u90e8\u95e86-10\uff09\u3002\u515c\u5e95\u90e8\u95e811\u65e0\u4e13\u5c5e\u5c97\u4f4d\u3002\u7531\u6ce8\u518c\u8868 ROLE_GROUPS \u81ea\u52a8\u6d3e\u751f\u3002"
    },
    "department_id": {
      "type": "string",
      "enum": [
        "outpatient",
        "refraction",
        "diagnostics",
        "surgery",
        "nursing",
        "front_desk",
        "marketing",
        "finance",
        "logistics",
        "admin",
        "supplemental"
      ],
      "description": "\u6240\u5c5e\u90e8\u95e8ID\uff0811\u4e2a\u6807\u51c6\u5316\u90e8\u95e8\u4e4b\u4e00\uff09\u3002\u7531\u5c97\u4f4d\u89d2\u8272\u81ea\u52a8\u6d3e\u751f\uff08ROLE_TO_DEPARTMENT\uff09\uff0csupplemental=\u515c\u5e95/\u4ee3\u4f20\u573a\u666f\u3002"
    },
    "status": {
      "type": "string",
      "enum": [
        "off_duty",
        "on_duty",
        "busy",
        "awaiting_confirm",
        "break"
      ],
      "default": "off_duty",
      "description": "\u5728\u5c97\u72b6\u6001\u8272\u6807\uff1a\u6b63\u5e38\u5728\u5c97\u9752\u7eff/\u5fd9\u788c\u84dd/\u72b6\u6001\u5f85\u786e\u8ba4\u7425\u73c0/\u79bb\u5c97\u7070"
    },
    "pad_online": {
      "type": "boolean",
      "default": false,
      "description": "PAD\u5fc3\u8df3\u5728\u7ebf\u72b6\u6001"
    },
    "current_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u5f53\u524d\u627f\u63a5\u4efb\u52a1ID\u5217\u8868"
    },
    "assigned_zone": {
      "type": "string",
      "description": "\u5206\u914d\u533a\u57df"
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u7b7e\u5230\u65f6\u95f4"
    }
  },
  "required": [
    "clinic_id",
    "staff_name",
    "role",
    "role_group",
    "status"
  ]
}