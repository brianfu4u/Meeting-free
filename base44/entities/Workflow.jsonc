{
  "name": "Workflow",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "workflow_family": {
      "type": "string",
      "description": "\u5de5\u4f5c\u6d41\u4e1a\u52a1\u65cf\uff08optometry/medical/vision_training/supplier \u7b49\uff09\uff1b\u957f\u671f\u4e1a\u52a1\u6839\u5bf9\u8c61\u7684\u4e1a\u52a1\u5206\u7c7b\uff0cCandidateFinder/Clustering/Guardrail \u8bfb\u53d6"
    },
    "subject_type": {
      "type": "string",
      "description": "\u4e3b\u4f53\u7c7b\u578b\uff08patient/supplier/staff \u7b49\uff09"
    },
    "subject_fingerprint": {
      "type": "object",
      "description": "\u4e3b\u4f53\u6307\u7eb9\uff08\u5982 {name, ...}\uff09\uff0c\u4f9b subject_conflict \u786c\u62a4\u680f\u6bd4\u5bf9",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "device_serial": {
      "type": "string",
      "description": "Explicit device identity used by Agent v1.1 hard-conflict validation"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stalled",
        "pending_manager_closure",
        "closed"
      ],
      "default": "active",
      "description": "\u5de5\u4f5c\u6d41\u6743\u5a01\u72b6\u6001\u673a\uff1aactive/stalled/pending_manager_closure/closed\uff1b\u72b6\u6001\u6d41\u8f6c\u552f\u4e00\u7531\u5e97\u957f\u5ba1\u6838\u63d0\u4ea4\u9a71\u52a8\uff0cAI \u4e0d\u5f97\u76f4\u63a5\u4fee\u6539"
    },
    "temporal_anchors": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date-time"
      },
      "default": [],
      "description": "\u65f6\u95f4\u951a\u70b9\u5217\u8868\uff0c\u4f9b CandidateFinder \u65f6\u7a7a\u5339\u914d\u8ba1\u7b97 min_delta_ms"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u5de5\u4f5c\u6d41\u542f\u52a8\u65f6\u95f4"
    },
    "last_event_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u6700\u8fd1\u4e8b\u4ef6\u65f6\u95f4"
    },
    "open_loops": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u672a\u95ed\u73af\u9879\u5217\u8868\uff1b\u7a7a\u6570\u7ec4\u8868\u793a\u5df2\u95ed\u73af\uff08attach_to_closed_workflow \u786c\u62a4\u680f\u4f9d\u636e\uff09"
    },
    "current_snapshot_id": {
      "type": "string",
      "description": "\u5f53\u524d\u6295\u5f71 WorkflowSnapshot ID \u6307\u9488\uff08\u4e0d\u53ef\u53d8\u5feb\u7167\u7b56\u7565\uff1a\u63d0\u4ea4\u65f6\u6307\u5411\u65b0\u7248\u672c\u5feb\u7167\uff09"
    },
    "current_snapshot_version": {
      "type": "number",
      "description": "\u5f53\u524d\u6295\u5f71\u7248\u672c\u53f7\uff1bcommit \u65f6 CAS \u66f4\u65b0\u76ee\u6807\uff0cstale proposal \u6bd4\u5bf9\u57fa\u51c6"
    },
    "session_id": {
      "type": "string",
      "description": "\u5173\u8054 PatientSession ID\uff08\u60a3\u8005\u76f8\u5173\u5de5\u4f5c\u6d41\u5fc5\u586b\uff0c\u975e\u60a3\u8005\u5de5\u4f5c\u6d41\u53ef\u7a7a\uff09"
    },
    "business_line": {
      "type": "string",
      "enum": [
        "optometry",
        "medical",
        "vision_training"
      ],
      "description": "\u4e1a\u52a1\u7ebf\uff08\u4e0e workflow_family \u5bf9\u9f50\u65f6\u586b\u5199\uff09"
    }
  },
  "required": [
    "clinic_id",
    "workflow_family",
    "status"
  ]
}