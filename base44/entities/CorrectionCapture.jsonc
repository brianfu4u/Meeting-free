    "artifact_id": {
      "type": "string",
      "description": "\u88ab\u64a4\u9500\u6302\u63a5\u7684 Artifact ID"
    },
    "manager_id": {
      "type": "string",
      "description": "\u6267\u884c un-attach \u7684\u5e97\u957f ID\uff08\u82e5\u53ef\u89e3\u6790\uff1b\u5426\u5219\u4e3a\u539f decision_actor_id\uff09"
    },
