      "type": "string",
      "description": "\u64a4\u9500\u539f\u56e0\uff08\u6765\u81ea link.correction_reason\uff09"
    },
    "label": {
      "type": "string",
      "description": "\u6807\u6ce8\u6807\u7b7e\uff0c\u9ed8\u8ba4 '\u8bef\u6302\u63a5'\uff1b\u540e\u7eed\u8c03\u4f18\u7684\u771f\u5b9e\u6807\u6ce8\u6570\u636e\u96c6\u5165\u53e3"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
