      "description": "\u6765\u6e90\u57df\uff08artifact.source_region\uff09"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u64a4\u9500\u6355\u83b7\u65f6\u95f4\u6233\uff08link.superseded_at\uff09"
