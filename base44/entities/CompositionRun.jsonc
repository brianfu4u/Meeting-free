{
  "name": "CompositionRun",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "门店唯一标识，严格 Tenant 逻辑隔离字段"
    },
    "business_date": {
      "type": "string",
      "format": "date",
      "description": "业务日期"
    },
    "slot": {
      "type": "string",
      "description": "运行时段，如 12:30/15:30/17:30"
    },
    "policy_version": {
      "type": "number",
      "description": "本次运行的 GuessPolicy 版本"
    },
    "cutoff_event_seq": {
      "type": "number",
      "description": "本次运行水位：仅处理该序号以内的 Artifact，新事件进入下一时段"
    },
    "cutoff_ingested_at": {
      "type": "string",
      "format": "date-time",
      "description": "记录水位时刻"
    },
    "run_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "运行开始时间"
    },
    "run_finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "运行结束时间"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "stale"],
      "default": "pending",
      "description": "运行状态"
    },
    "idempotency_key": {
      "type": "string",
      "description": "运行幂等键 = clinic_id+business_date+slot+policy_version+cutoff_event_seq"
    },
    "proposals_generated": {
      "type": "number",
      "default": 0,
      "description": "本轮生成的提案数"
    },
    "artifact_ids_processed": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "本轮处理的 Artifact ID 列表"
    },
    "trigger_type": {
      "type": "string",
      "enum": ["manual", "scheduled", "manager_manual", "cutoff_reconciliation"],
      "default": "manager_manual",
      "description": "运行触发来源；manual 仅用于历史兼容"
    },
    "prompt_version": {
      "type": "string",
      "description": "本轮编组使用的 Prompt 版本"
    },
    "model_version": {
      "type": "string",
      "description": "本轮编组使用的模型版本"
    },
    "contract_version": {
      "type": "number",
      "description": "Phase 3 编排契约版本"
    },
    "error_code": {
      "type": "string",
      "description": "安全、可枚举的失败代码，不含底层异常详情"
    },
    "error_message": {
      "type": "string",
      "description": "面向调用方的安全失败摘要，不得存储 token/stack/原始异常"
    },
    "auto_attach_mode": {
      "type": "string",
      "enum": ["observe", "commit"],
      "description": "Agent authority gate used for this Run; observe never writes Snapshot/Link/Undo projections"
    },
    "auto_attach_eligible": {
      "type": "boolean",
      "description": "Whether the unique best candidate passed every authoritative attachment gate"
    },
    "auto_attach_gate_reasons": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Non-evaluative machine-readable reasons why authority remained closed"
    },
    "auto_attach_hypothesis_id": {
      "type": "string",
      "description": "Unique best hypothesis evaluated by the authority gate"
    },
    "auto_attach_outcome": {
      "type": "string",
      "enum": ["not_eligible", "observed", "cas_retryable", "committed"],
      "description": "Outcome of the authority gate without evaluative or alert semantics"
    },
    "expected_missing_segments": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Descriptive reverse-inference projections only; never facts, validation blocks, or closure evidence"
    },
    "reverse_inference_rule_codes": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Policy rule codes that produced expected_missing projections"
    },
    "llm_audit_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether this Run is queued for scheduled LLM logic audit; never implies manager dispatch"
    },
    "llm_audit_type": {
      "type": "string",
      "enum": ["pre_attach_audit", "post_attach_quality_audit"],
      "description": "Scheduled LLM audit class"
    },
    "llm_audit_reason_codes": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Non-evaluative reasons for entering the LLM audit queue"
    },
    "llm_audit_status": {
      "type": "string",
      "enum": ["queued", "confirmed", "flagged", "rejected", "correction_proposed"],
      "description": "LLM audit lifecycle; only flagged may later become manager-visible"
    }
  },
  "required": [
    "clinic_id",
    "business_date",
    "slot",
    "policy_version",
    "cutoff_event_seq",
    "status",
    "idempotency_key"
  ]
}
