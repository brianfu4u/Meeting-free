    "decision_note": {
      "type": "string",
      "description": "\u51b3\u7b56\u5907\u6ce8"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u51b3\u7b56\u65f6\u95f4"
    }
  },
  "required": [
    "clinic_id",
    "manager_id",
    "target_type",
    "target_id",
    "decision",
    "decided_at"
  ]
}