{
  "name": "ManagerDecision",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "manager_id": {
      "type": "string",
      "description": "\u5e97\u957f\u5458\u5de5ID"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "task",
        "alert",
        "staff_request"
      ],
      "description": "\u51b3\u7b56\u5bf9\u8c61\u7c7b\u578b"
    },
    "target_id": {
      "type": "string",
      "description": "\u51b3\u7b56\u5bf9\u8c61ID"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "ignored"
      ],
      "description": "\u4e09\u9009\u4e00\u51b3\u7b56\uff1a\u540c\u610f/\u62d2\u7edd/\u5ffd\u7565"
