{
  "name": "ManagerDecision",
  "type": "object",
  "properties": {
    "clinic_id": {
      "type": "string",
      "description": "\u95e8\u5e97\u552f\u4e00\u6807\u8bc6\uff0c\u5baa\u6cd5\u7ea7\u7269\u7406\u9694\u79bb\u5b57\u6bb5"
    },
    "manager_id": {
      "type": "string",
      "description": "\u5e97\u957f\u5458\u5de5ID"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "task",
        "alert",
        "staff_request",
        "hypothesis",
        "proposal",
        "artifact_exception"
      ],
      "description": "\u51b3\u7b56\u5bf9\u8c61\u7c7b\u578b\uff08Phase 3 \u8ffd\u52a0 hypothesis/proposal\uff0c\u7528\u4e8e\u7f16\u7ec4\u5ba1\u6838\u63d0\u4ea4\uff09"
    },
    "target_id": {
      "type": "string",
      "description": "\u51b3\u7b56\u5bf9\u8c61ID"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "ignored"
      ],
      "description": "\u4e09\u9009\u4e00\u51b3\u7b56\uff1a\u540c\u610f/\u62d2\u7edd/\u5ffd\u7565\uff08Phase 3 \u6620\u5c04\uff1aAttentionItem.manager_action=execute\u2192approved\uff0cignore\u2192ignored\uff0cescalate\u2192approved+\u5347\u7ea7\u5907\u6ce8\uff09"
    },
    "decision_note": {
      "type": "string",
      "description": "\u51b3\u7b56\u5907\u6ce8"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u51b3\u7b56\u65f6\u95f4"
    },
    "commit_intent_id": {
      "type": "string",
      "description": "Phase 3\uff1a\u5173\u8054 WorkflowCommitIntent ID\uff08\u63d0\u4ea4\u578b\u51b3\u7b56\u552f\u4e00 Saga \u53e5\u67c4\uff09"
    },
    "decision_scope": {
      "type": "string",
      "enum": ["exception_archive_only"],
      "description": "Manager exception approval is an isolated audit record, never a normal assembly precedent"
    },
    "exception_class": {
      "type": "string",
      "enum": ["manager_approved_exception"],
      "description": "Audited exception class"
    },
    "normal_rule_learning_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Must remain false for exception archive decisions"
    },
    "policy_version_at_decision": {
      "type": "number",
      "description": "Read-only policy version observed at decision time; the decision never mutates Policy"
    }
  },
  "required": [
    "clinic_id",
    "manager_id",
    "target_type",
    "target_id",
    "decision",
    "decided_at"
  ]
}